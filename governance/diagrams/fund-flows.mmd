%%{init: {"themeVariables": {"fontSize": "14px"}}}%%
flowchart TD
    subgraph SAT["Satellite (nonprofit) — donor-funded, owns the treasury"]
        Donor(Donor / Funder)
        SatBank[Bank account - near-term ops only]
        Treasury[Multisig Treasury - held as ETH]
        BatchConvert[[Periodic ETH to DAI batch convert -<br/>monthly/qtrly, single multisig sign-off]]
        DAIFloat[DAI - operating float]
        Hedge[[Hedging - staged:<br/>once treasurer hired]]
    end

    subgraph SUB["Subsidiary (for-profit) — customer revenue"]
        Customer(Paying customer)
        SubBank[Bank account - near-term ops only]
    end

    DonationProcessor[Giving Block - streamlines tax receipts<br/>for crypto donations]
    Contributors{{Contributors}}
    ContribOfframp(Contributor's own fiat off-ramp)
    VendorsCrypto{{Vendors - DAI-accepting}}
    OffRampJIT[Request Finance - JIT off-ramp,<br/>pays vendor directly]
    VendorsFiat{{Vendors - not accepting DAI,<br/>paid in fiat}}

    subgraph LEGEND["Legend"]
        L1[Asset or account held by an entity]
        L1b[[Process run by an entity]]
        L2[External party or service,<br/>outside both entities]
    end

    Donor -- "<b style='font-size:2.3em'>①</b> cash/USD" --> SatBank
    SatBank -- "<b style='font-size:2.3em'>①</b> periodic sweep" --> Treasury
    Donor -- "<b style='font-size:2.3em'>①</b> DAI directly" --> DAIFloat
    Donor -- "<b style='font-size:2.3em'>①</b> ETH, or BTC swapped to ETH" --> Treasury
    Customer -- "<b style='font-size:2.3em'>①</b> card/ACH, mostly fiat" --> SubBank
    SubBank -- "<b style='font-size:2.3em'>①</b> periodic sweep" --> Treasury

    Donor -.->|"deferred until volume or<br/>Form 8283 threshold hit"| DonationProcessor

    Treasury -- "<b style='font-size:2.3em'>②</b> periodic batch, single sign-off" --> BatchConvert
    BatchConvert -- "<b style='font-size:2.3em'>②</b>" --> DAIFloat

    DAIFloat -- "<b style='font-size:2.3em'>③</b> wallet-to-wallet" --> Contributors
    Contributors -- "<b style='font-size:2.3em'>③</b> own responsibility" --> ContribOfframp
    DAIFloat -- "<b style='font-size:2.3em'>③</b> wallet-to-wallet, potential discount" --> VendorsCrypto
    DAIFloat -- "<b style='font-size:2.3em'>③</b> processor converts +<br/>pays vendor in one settlement" --> OffRampJIT
    OffRampJIT -- "<b style='font-size:2.3em'>③</b>" --> VendorsFiat
    SatBank -- "<b style='font-size:2.3em'>③</b> ACH/card,<br/>routine ops" --> VendorsFiat
    SubBank -- "<b style='font-size:2.3em'>③</b> ACH/card,<br/>routine ops" --> VendorsFiat

    Treasury -.->|"<b style='font-size:2.3em'>④</b> deferred until<br/>treasurer on board"| Hedge

    SatBank ~~~ Customer
    VendorsFiat ~~~ LEGEND
    DonationProcessor -.-> SatBank

    linkStyle 0,1,2,3,4,5 stroke:#d62728,color:#d62728
    linkStyle 7,8 stroke:#1f77b4,color:#1f77b4
    linkStyle 9,10,11,12,13,14,15 stroke:#2ca02c,color:#2ca02c
    linkStyle 6,16,19 stroke:#888888,color:#888888,stroke-dasharray: 5 5

    classDef owned fill:#eaf2fb,stroke:#1f77b4,stroke-width:3px
    classDef external fill:#fdf0e3,stroke:#e07b00,stroke-width:2px,stroke-dasharray:3 3
    class L1,L1b owned
    class L2 external
    class Treasury,SatBank,SubBank,BatchConvert,DAIFloat,Hedge owned
    class Donor,DonationProcessor,Customer,Contributors,ContribOfframp external
    class VendorsCrypto,OffRampJIT,VendorsFiat external
